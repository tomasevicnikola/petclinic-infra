[Unit]
# Managed by Ansible (roles/app_deploy). Edits here are overwritten.
Description=PetClinic application container
Documentation=https://github.com/tomasevicnikola/petclinic-infra
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

{% if '@sha256:' not in app_deploy_image %}
ExecStartPre=-/usr/bin/docker pull {{ app_deploy_image }}
{% else %}
{% endif %}
ExecStart={{ app_deploy_run_script }}

ExecStop=-/usr/bin/docker stop --timeout 30 {{ app_deploy_container_name }}

Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
