[Unit]
# Managed by Ansible (roles/app_runtime), baked into the petclinic-app image.
# Edits here are overwritten by the next image build.
Description=PetClinic application container
Documentation=https://github.com/tomasevicnikola/petclinic-infra
Requires=docker.service
# snapd.seeded because the run script calls the gcloud snap, whose mount can lag
# multi-user.target on a cold boot.
After=docker.service network-online.target snapd.seeded.service
Wants=network-online.target snapd.seeded.service

# Past ten minutes, autohealing replacing the instance is the better repair.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple

ExecStart={{ app_runtime_run_script }}
ExecStop=-/usr/bin/docker stop --timeout 30 {{ app_runtime_container_name }}

Restart=on-failure
RestartSec=10s

TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
