{
  "uid": "petclinic-nodes",
  "title": "PetClinic - Node / VM overview",
  "description": "CPU, memory, disk and network for every VM Prometheus discovers, across all environments. Instances arrive and leave here on their own: the app VMs come from GCE service discovery and carry the env label from their app-env instance metadata.",
  "tags": [
    "petclinic",
    "nodes"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=~\"node.*\"}, env)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=~\"node.*\"}, env)",
          "refId": "env"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Fleet",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "VMs exporting",
      "description": "Instances whose node exporter answered the last scrape. This falls when a VM dies and when the autoscaler scales in - the second is not an incident.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(up{job=~\"node.*\", env=~\"$env\"} == 1)",
          "legendFormat": "up",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Busiest CPU",
      "description": "The hottest VM right now. HighCPU fires above 80% held for 5m.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(100 - (avg by (instance) (rate(node_cpu_seconds_total{env=~\"$env\", mode=\"idle\"}[5m])) * 100))",
          "legendFormat": "cpu",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Fullest memory",
      "description": "Measured as unavailable rather than not-free, so page cache is not counted against it. HighMemory fires above 85% held for 5m.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
