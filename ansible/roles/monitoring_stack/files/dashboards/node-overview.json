      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max((1 - (node_memory_MemAvailable_bytes{env=~\"$env\"} / node_memory_MemTotal_bytes{env=~\"$env\"})) * 100)",
          "legendFormat": "mem",
          "range": true,
          "refId": "A"
        }
      ]
    },
