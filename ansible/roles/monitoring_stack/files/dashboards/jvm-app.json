{
  "uid": "petclinic-jvm",
  "title": "PetClinic - JVM / application",
  "description": "Micrometer metrics from /actuator/prometheus on every application instance: HTTP throughput, latency and errors, JVM heap and GC, and the database connection pool.",
  "tags": [
    "petclinic",
    "jvm"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"petclinic-app\"}, env)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"petclinic-app\"}, env)",
          "refId": "env"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
