      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"petclinic-app\", env=~\"$env\", instance=~\"$instance\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"petclinic-app\", env=~\"$env\", instance=~\"$instance\"}[5m])), 0.001)",
          "legendFormat": "errors",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Mean latency",
      "description": "Mean, not a percentile. Micrometer ships http_server_requests as a summary with no histogram buckets unless the application turns on percentiles-histogram, so there are no buckets to compute quantiles from. See docs/monitoring.md.",
