          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"petclinic-app\", env=~\"$env\", instance=~\"$instance\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"petclinic-app\", env=~\"$env\", instance=~\"$instance\"}[5m])), 0.001)",
          "legendFormat": "latency",
          "range": true,
          "refId": "A"
        }
      ]
    },
