        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"petclinic-app\", env=~\"$env\"}, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"petclinic-app\", env=~\"$env\"}, instance)",
          "refId": "instance"
