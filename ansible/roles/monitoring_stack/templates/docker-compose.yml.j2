# Managed by Ansible (roles/monitoring_stack). Edits here are overwritten.
---
name: {{ monitoring_stack_compose_project }}

services:
  prometheus:
    image: {{ monitoring_stack_prometheus_ref }}
    container_name: petclinic-prometheus
    restart: unless-stopped

    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ monitoring_stack_retention_time }}
      - --storage.tsdb.retention.size={{ monitoring_stack_retention_size }}
      - --web.console.libraries=/usr/share/prometheus/console_libraries
      - --web.console.templates=/usr/share/prometheus/consoles

    volumes:
      - {{ monitoring_stack_root }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus

    ports:
      - "{{ monitoring_stack_bind_address }}:{{ monitoring_stack_prometheus_port }}:9090"

    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  grafana:
    image: {{ monitoring_stack_grafana_ref }}
    container_name: petclinic-grafana
    restart: unless-stopped
    depends_on:
      - prometheus

    environment:
      # `:?` so compose refuses to start rather than fall back to admin/admin.
      GF_SECURITY_ADMIN_PASSWORD: ${GF_SECURITY_ADMIN_PASSWORD:?read from Secret Manager by petclinic-monitoring-up.sh}
      GF_SECURITY_ADMIN_USER: admin

      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_BASIC_ENABLED: "true"

      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"

      GF_SERVER_ROOT_URL: http://localhost:{{ monitoring_stack_grafana_port }}/

    volumes:
      - grafana-data:/var/lib/grafana
      - {{ monitoring_stack_root }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ monitoring_stack_root }}/grafana/dashboards:/var/lib/grafana/dashboards:ro

    ports:
      - "{{ monitoring_stack_bind_address }}:{{ monitoring_stack_grafana_port }}:3000"

    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

volumes:
  prometheus-data:
  grafana-data:
